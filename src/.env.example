# Application & Server
APP_NAME=Asset-Aware-Security-Intelligence
PORT=8080
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL / Neon)
JDBC_DATABASE_URL=jdbc:postgresql://ep-your-db-endpoint.aws.neon.tech/neondb?sslmode=require
DB_USER=your_db_username
DB_PASSWORD=your_db_password
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT Security
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_key_here

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_TIMEOUT=5000

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
